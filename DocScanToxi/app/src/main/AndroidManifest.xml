<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Kamera dibuka oleh pemindai Google atau aplikasi kamera sistem.
         Tidak ada izin penyimpanan atau kamera yang diminta oleh aplikasi. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DocScanToxi">

        <activity android:name=".MainActivity" android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DocScanToxi.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".DocumentActivity" android:exported="false" />
        <activity android:name=".edit.PageEditActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".pdf.NativePdfActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity android:name=".pdf.PdfMergeActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".zip.ZipActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".office.OfficeActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity android:name=".edit.TextEditActivity" android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <activity android:name=".ocr.OcrActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
